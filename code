}

// =====================================================
// SETUP
// =====================================================

void setup()
{
    Serial.begin(115200);

    // =================================================
    // PUMP SAFETY - INITIALIZE FIRST
    // =================================================

    pinMode(PUMP_IN3, OUTPUT);
    pinMode(PUMP_IN4, OUTPUT);

    // Force pump OFF immediately
    digitalWrite(PUMP_IN3, LOW);
    digitalWrite(PUMP_IN4, LOW);

    // =================================================
    // MOTOR PINS
    // =================================================

    pinMode(L_IN1, OUTPUT);
    pinMode(L_IN2, OUTPUT);
    pinMode(L_IN3, OUTPUT);
    pinMode(L_IN4, OUTPUT);

    pinMode(R_IN1, OUTPUT);
    pinMode(R_IN2, OUTPUT);
    pinMode(R_IN3, OUTPUT);
    pinMode(R_IN4, OUTPUT);

    // Force motors OFF
    digitalWrite(L_IN1, LOW);
    digitalWrite(L_IN2, LOW);
    digitalWrite(L_IN3, LOW);
    digitalWrite(L_IN4, LOW);

    digitalWrite(R_IN1, LOW);
    digitalWrite(R_IN2, LOW);
    digitalWrite(R_IN3, LOW);
    digitalWrite(R_IN4, LOW);

    // =================================================
    // SPRAY LED PINS
    // =================================================

    pinMode(RED_LED, OUTPUT);
    pinMode(YELLOW_LED, OUTPUT);
    pinMode(GREEN_LED, OUTPUT);

    // LEDs OFF
    digitalWrite(RED_LED, LOW);
    digitalWrite(YELLOW_LED, LOW);
    digitalWrite(GREEN_LED, LOW);

    // =================================================
    // PUMP OFF
    // =================================================

    pumpOff();

    // =================================================
    // LCD
    // =================================================

    detectLCD();

    if (lcdFound)
    {
        // Main startup presentation
        showStartupSequence();
    }

    // =================================================
    // INITIAL STATE
    // =================================================

    stopMotors();

    // Don't show spray complete during boot.
    // Just make sure everything is physically OFF.
    digitalWrite(RED_LED, LOW);
    digitalWrite(YELLOW_LED, LOW);
    digitalWrite(GREEN_LED, LOW);
    pumpOff();

    spraying = false;
    sprayStatus = "OFF";

    // =================================================
    // WIFI
    // =================================================

    connectWiFi();

    // =================================================
    // WEB ROUTES
    // =================================================

    server.on("/", handleRoot);

    // Motor
    server.on("/forward", handleForward);
    server.on("/backward", handleBackward);
    server.on("/left", handleLeft);
    server.on("/right", handleRight);
    server.on("/stop", handleStop);

    // Spray
    server.on("/spray_normal", handleSprayNormal);
    server.on("/spray_moderate", handleSprayModerate);
    server.on("/spray_high", handleSprayHigh);
    server.on("/spray_stop", handleSprayStop);

    // Test
    server.on("/test", handleTest);

    // Unknown URLs
    server.onNotFound(handleNotFound);

    // =================================================
    // START WEB SERVER
    // =================================================

    server.begin();

    Serial.println();
    Serial.println("==============================");
    Serial.println("WEB SERVER STARTED");
    Serial.print("Open: http://");
    Serial.print(WiFi.localIP());
    Serial.println("/");
    Serial.println("==============================");

    // Don't show WEB CONTROL.
    // Return to autonomous presentation state.
    lcdDisplay("AUTONOMOUS", "MODE");
}

// =====================================================
// LOOP
// =====================================================

void loop()
{
    server.handleClient();

    updateSprayTimer();
}
